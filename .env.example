# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Supabase configuration for optional auth/storage integration.
# Keep Convex as the primary backend until you complete a staged migration.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only. Never expose in the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
